NEO4J_URI=bolt://127.0.0.1:7687
NEO4J_USER=neo4j
NEO4J_PASSWORD=change-me
NEO4J_DATABASE=neo4j

# These values may only lower the compiled hard limits.
GRAPHKODA_MCP_MAX_DEPTH=6
GRAPHKODA_MCP_MAX_PATHS=50
GRAPHKODA_MCP_MAX_NODES=300
GRAPHKODA_MCP_MAX_EDGES=600
GRAPHKODA_MCP_MAX_OUTPUT_BYTES=262144
GRAPHKODA_MCP_QUERY_TIMEOUT_SECONDS=15

# Comma-separated allowlist. Requests can select only from this list.
GRAPHKODA_MCP_RELATIONSHIP_TYPES=STATIC_CALLS,STATIC_DEF,CALLS_AT_RUNTIME,response,AST_CHILD,CONTAINS_STEP,NEXT_STEP
